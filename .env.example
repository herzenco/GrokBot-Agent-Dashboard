# Supabase project URL, server side only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Supabase service role key. Server side only. Bypasses RLS. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Password Tito types on the login page.
DASHBOARD_PASSWORD=

# HMAC secret for the session cookie. Use a long random value, for example: openssl rand -base64 32
SESSION_SECRET=

# Admin agent API key. May act for any agent. Use a long random value, for example: openssl rand -base64 32
ADMIN_API_KEY=
